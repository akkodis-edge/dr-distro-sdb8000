[Unit]
Description=Start psplash boot splash screen
DefaultDependencies=no
RequiresMountsFor=/run
ConditionFileIsExecutable=/usr/bin/psplash
BindsTo=sys-devices-platform-soc\x400-32c00000.bus-32e00000.lcdif-graphics-fb0.device
After=sys-devices-platform-soc\x400-32c00000.bus-32e00000.lcdif-graphics-fb0.device

[Service]
Type=notify
ExecStart=/usr/bin/psplash
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
